# Postgres. Same isolated :5433 cluster as mediahub/asrhub, but llmhub's own database+role,
# so none of the three can read or corrupt another's tables.
LLMHUB_PG_HOST=
LLMHUB_PG_PORT=
LLMHUB_PG_DB=
LLMHUB_PG_USER=
LLMHUB_PG_PASSWORD=

# Native API (/v1/*). One key per worker, so worker_id is authenticated rather than
# self-asserted. Format: "<worker_id>:<key>,<worker_id>:<key>,..."
LLMHUB_WORKER_KEYS=

# /v1/admin/* - source enable/disable, reload-keys, reload-tasksets, queue inspection.
LLMHUB_ADMIN_KEY=

# The PHP-compatible shim's HTTP Basic credentials. On har this was Apache's .htaccess
# (Require group admins); here the shim checks it itself, because fw and ochat both send
# HTTPBasicAuth and neither is going to change for the cutover.
# Format: "<user>:<password>,<user>:<password>,..."
LLMHUB_BASIC_USERS=

# mediahub, where the bodies live: the transcript as a transcript, each task answer as an
# annotation. Empty means llmhub keeps everything in its local spool and retries later -
# the queue must never stop because the store is down.
MEDIAHUB_URL=
MEDIAHUB_API_KEY=

# The shared harmonica.cloud Basic credential (the same one fw/ochat use).
# Only scripts/shadow_compare.py reads it, to peek the live PHP hub for comparison.
HARMONICA_BASIC_AUTH_USER=
HARMONICA_BASIC_AUTH_PASSWORD=
