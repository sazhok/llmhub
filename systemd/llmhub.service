[Unit]
Description=llmhub (LLM checklist job queue - the LLM half of worker_acceptor_light.php)
After=network-online.target postgresql@16-mediahub.service
Wants=network-online.target
# llmhub has its own database, but it lives in the same isolated :5433 cluster mediahub runs
# in - hence the unit name.
Requires=postgresql@16-mediahub.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hrm/local/llmhub
# The tailnet IP, not loopback: fw's llmmon orders from oa/qd/az. See serve.sh's comment.
ExecStart=/home/ubuntu/hrm/local/llmhub/.venv/bin/uvicorn llmhub.app:app --host 100.97.153.111 --port 8008 --log-config uvicorn_log_config.json
# SIGHUP reloads API keys without dropping in-flight leases (auth.install_sighup_handler)
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
